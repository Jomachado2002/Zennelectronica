{
    "version" : 2,
    "name" : "Full Stack",
    "builds" : [
        {
            "src" : "./index.js",
            "use" : "@vercel/node",
            "config": { "maxDuration": 60 }
        }
    ],
    "routes" : [
        {
            "src" : "/(.*)",
            "dest" : "/"
        }
    ]
}