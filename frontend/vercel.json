{
  "headers": [
    {
      "source": "/producto/:slug*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
      ]
    },
    {
      "source": "/api/seo/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cache-Control", "value": "public, max-age=600, s-maxage=43200, stale-while-revalidate=604800" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=43200, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=21600, stale-while-revalidate=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=21600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/sitemap.xml",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=21600, stale-while-revalidate=86400" },
        { "key": "Vercel-CDN-Cache-Control", "value": "public, s-maxage=21600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://zennelectronica.vercel.app/api/sitemap.xml"
    },
    {
      "source": "/api/:path*",
      "destination": "https://zennelectronica.vercel.app/api/:path*"
    },
    {
      "source": "/producto/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|bingbot|bingpreview|yandex|baiduspider|twitterbot|facebookexternalhit|linkedinbot|whatsapp|telegrambot|duckduckbot|applebot|semrushbot|ahrefsbot|storebot-google|adsbot-google|mediapartners-google).*"
        }
      ],
      "destination": "https://zennelectronica.vercel.app/api/seo/producto/:slug*"
    }
  ]
}
